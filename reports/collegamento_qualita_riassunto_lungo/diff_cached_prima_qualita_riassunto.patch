-      'scarica txt',
-      'scarica html',
-      'scarica pdf',
-      'scarica json',
-      'materiale generato',
-      'dopo aver generato'
-    ];
-
-    for (const b of bad) {
-      if (s.includes(b)) score -= 10;
-    }
-
-    return score;
-  }
