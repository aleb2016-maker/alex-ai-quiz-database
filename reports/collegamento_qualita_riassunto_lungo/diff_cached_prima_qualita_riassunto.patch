-      if (STOPWORDS.has(word)) continue;
-      freq.set(word, (freq.get(word) || 0) + 1);
-    }
-
-    return [...freq.entries()]
-      .sort((a, b) => b[1] - a[1])
-      .slice(0, limit)
-      .map(([word]) => word);
-  }
